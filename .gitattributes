# Normalize line endings
* text=auto

# Notebook diffs
*.ipynb diff=jupyternotebook

# LFS — large binary artifacts (full merged models only)
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text

# LoRA adapter and outputs are small — track directly in git, not LFS
models/lfm2-nk-risk/lora_adapter/*.safetensors -filter -diff -merge text
data/outputs/*.json -filter -diff -merge
